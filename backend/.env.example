# 복사해서 .env 로 사용 (.env 는 커밋 금지). 발급 방법: docs/API_KEYS.md
PORT=8080
# 비어 있으면 해당 Provider 는 Mock(샘플 데이터)으로 동작
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
DATA_GO_KR_SERVICE_KEY=
KAKAO_REST_API_KEY=
# 앱 → 서버 호출용 토큰 (임의의 긴 문자열)
APP_API_TOKEN=dev-token

# 해외 숙소 가격·평점 (SerpAPI Google Hotels, 무료 월 250회). 월 호출 상한(기본 150)
SERPAPI_KEY=
# SERPAPI_MONTHLY_BUDGET=150
